# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Enable testability for proper SF2 file handling in TestFlight builds
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_TESTABILITY'] = 'YES'
      # Ensure proper resource bundling for audio files
      config.build_settings['EXCLUDED_SOURCE_FILE_NAMES'] = ''
      # Only update deployment target if it's below 15.0
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
      # Remove outdated arm64 simulator exclusion (needed for Apple Silicon Macs)
      config.build_settings.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
    end
  end

  # Also remove arm64 exclusion from the generated aggregate xcconfigs
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.xcconfigs.each do |config_name, config_file|
      config_file.attributes.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
      xcconfig_path = aggregate_target.xcconfig_path(config_name)
      config_file.save_as(xcconfig_path)
    end
  end

  # Add script phase to generate dSYM for objective_c.framework (Dart native asset)
  # This fixes App Store Connect warning about missing dSYM UUIDs
  runner_project = Xcodeproj::Project.open(File.join(__dir__, 'Runner.xcodeproj'))
  runner_target = runner_project.targets.find { |t| t.name == 'Runner' }
  phase_name = 'Generate objective_c.framework dSYM'
  # Remove old version if it exists (to update the script)
  runner_target.shell_script_build_phases.select { |p| p.name == phase_name }.each do |p|
    runner_target.build_phases.delete(p)
  end
  phase = runner_target.new_shell_script_build_phase(phase_name)
  phase.shell_script = <<~SCRIPT
    # Generate dSYM for objective_c.framework (Dart native asset missing dSYM)
    # Search in multiple locations: embedded frameworks in app bundle, and BUILD_DIR
    FW_BINARY=""

    # 1. Check the app's embedded Frameworks folder (most reliable for archive builds)
    APP_FW="${BUILT_PRODUCTS_DIR}/${FRAMEWORKS_FOLDER_PATH}/objective_c.framework/objective_c"
    if [ -f "$APP_FW" ]; then
      FW_BINARY="$APP_FW"
      echo "[dSYM] Found objective_c in app bundle: $APP_FW"
    fi

    # 2. Fallback: search BUILD_DIR for native_assets path
    if [ -z "$FW_BINARY" ]; then
      FW_BINARY=$(find "${BUILD_DIR}" -name "objective_c" -path "*/objective_c.framework/*" -type f 2>/dev/null | head -1)
      if [ -n "$FW_BINARY" ]; then
        echo "[dSYM] Found objective_c in BUILD_DIR: $FW_BINARY"
      fi
    fi

    # 3. Fallback: search CODESIGNING_FOLDER_PATH (archive products)
    if [ -z "$FW_BINARY" ] && [ -n "${CODESIGNING_FOLDER_PATH}" ]; then
      FW_BINARY=$(find "${CODESIGNING_FOLDER_PATH}" -name "objective_c" -path "*/objective_c.framework/*" -type f 2>/dev/null | head -1)
      if [ -n "$FW_BINARY" ]; then
        echo "[dSYM] Found objective_c in CODESIGNING_FOLDER_PATH: $FW_BINARY"
      fi
    fi

    if [ -n "$FW_BINARY" ] && [ -d "${DWARF_DSYM_FOLDER_PATH}" ]; then
      echo "[dSYM] Generating dSYM for objective_c.framework..."
      dsymutil "$FW_BINARY" -o "${DWARF_DSYM_FOLDER_PATH}/objective_c.framework.dSYM" 2>/dev/null || true
      if [ -d "${DWARF_DSYM_FOLDER_PATH}/objective_c.framework.dSYM" ]; then
        echo "[dSYM] Success: created objective_c.framework.dSYM"
      else
        echo "[dSYM] Warning: dsymutil did not produce a dSYM bundle"
      fi
    else
      echo "[dSYM] objective_c.framework binary not found or DWARF_DSYM_FOLDER_PATH not set"
      echo "[dSYM] BUILT_PRODUCTS_DIR=${BUILT_PRODUCTS_DIR}"
      echo "[dSYM] FRAMEWORKS_FOLDER_PATH=${FRAMEWORKS_FOLDER_PATH}"
      echo "[dSYM] BUILD_DIR=${BUILD_DIR}"
    fi
  SCRIPT
  runner_project.save
  puts "[Podfile] Updated '#{phase_name}' build phase on Runner target"
end
